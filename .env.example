# SecureEvidence Application Configuration Template
# Copy this file to .env and adjust variables as needed

# Server & Mode
PORT=8000
DEMO_MODE=true
PUBLIC_BASE_URL=http://localhost:8000
AUTHOR_EMAIL=nathenaelermias13@gmail.com

# Ledger Backend & Storage
# Options: 'sqlite' (default, persistent hash-chained DB) or 'memory' (in-memory, resets on restart)
LEDGER_BACKEND=sqlite
LEDGER_DB_PATH=data/ledger.db

# Blockchain / Chain Anchor Configuration
# Options for CHAIN_MODE: 'off' (default), 'local', 'sepolia'
CHAIN_MODE=
CHAIN_RPC_URL=
CHAIN_ID=
CONTRACT_ADDRESS=
SUBMITTER_PRIVATE_KEY=
EXPLORER_BASE_URL=
CONFIRMATIONS=
HEAD_ANCHOR_EVERY=

# Authentication & Security
# Strictly required if DEMO_MODE=false
JWT_SECRET=INSA-DEMO-DEVELOPMENT-SECRET-KEY-CHANGE-IN-PROD
FEATURE_COVERAGE_THRESHOLD=0.60

# Real Streaming Pipeline (Kafka + Spark Structured Streaming + XGBoost in WSL)
STREAM_API_URL=http://127.0.0.1:8100
STREAM_WSL_DISTRO=Ubuntu-22.04
